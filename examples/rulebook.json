{
  "owner": {"telegram_user_id": "12345678"},
  "protected": true,
  "actions": {
    "slack.post": {
      "fields": ["text"],
      "targets": {"#customer-updates": "C0123456789", "#sandbox": "C0123456790"},
      "https": {
        "url": "https://slack.com/api/chat.postMessage",
        "method": "POST", "auth": "Bearer", "secret": "RULEBOOK_SLACK_TOKEN",
        "body": {"channel": "$destination", "text": "$text", "mrkdwn": false,
                 "unfurl_links": false, "unfurl_media": false},
        "require": "ok", "receipt": "ts"
      }
    },
    "discord.post": {
      "fields": ["text"],
      "targets": {"#sandbox": "123456789012345678"},
      "https": {
        "url": "https://discord.com/api/v10/channels/{destination}/messages",
        "method": "POST", "auth": "Bot", "secret": "RULEBOOK_DISCORD_TOKEN",
        "body": {"content": "$text", "allowed_mentions": {"parse": []}},
        "receipt": "id"
      }
    },
    "github.create_issue": {
      "fields": ["title", "text"],
      "targets": {"example-repo": "example/example"},
      "https": {
        "url": "https://api.github.com/repos/{destination}/issues",
        "method": "POST", "auth": "Bearer", "secret": "RULEBOOK_GITHUB_TOKEN",
        "body": {"title": "$title", "body": "$text"},
        "receipt": "number"
      }
    },
    "notion.comment": {
      "fields": ["text"],
      "targets": {"notes": "00000000-0000-4000-8000-000000000001"},
      "https": {
        "url": "https://api.notion.com/v1/comments",
        "method": "POST", "auth": "Bearer", "secret": "RULEBOOK_NOTION_TOKEN",
        "headers": {"Notion-Version": "2025-09-03"},
        "body": {"parent": {"page_id": "$destination"}, "rich_text": [{"text": {"content": "$text"}}]},
        "receipt": "id"
      }
    },
    "linear.create_issue": {
      "fields": ["title", "text"],
      "targets": {"engineering": "00000000-0000-4000-8000-000000000002"},
      "https": {
        "url": "https://api.linear.app/graphql",
        "method": "POST", "auth": "Raw", "secret": "RULEBOOK_LINEAR_TOKEN",
        "body": {
          "query": "mutation CreateIssue($input: IssueCreateInput!) { issueCreate(input: $input) { success issue { id } } }",
          "variables": {"input": {"teamId": "$destination", "title": "$title", "description": "$text"}}
        },
        "require": "data.issueCreate.success", "receipt": "data.issueCreate.issue.id"
      }
    },
    "asana.create_task": {
      "fields": ["title", "text"],
      "targets": {"team-project": "1234567890123456"},
      "https": {
        "url": "https://app.asana.com/api/1.0/tasks",
        "method": "POST", "auth": "Bearer", "secret": "RULEBOOK_ASANA_TOKEN",
        "body": {"data": {"projects": ["$destination"], "name": "$title", "notes": "$text"}},
        "receipt": "data.gid"
      }
    },
    "clickup.create_task": {
      "fields": ["title", "text"],
      "targets": {"team-list": "123456789"},
      "https": {
        "url": "https://api.clickup.com/api/v2/list/{destination}/task",
        "method": "POST", "auth": "Raw", "secret": "RULEBOOK_CLICKUP_TOKEN",
        "body": {"name": "$title", "description": "$text"},
        "receipt": "id"
      }
    },
    "todoist.create_task": {
      "fields": ["title", "text"],
      "targets": {"personal": "6HWcc9PJCvPjCxC9"},
      "https": {
        "url": "https://api.todoist.com/api/v1/tasks",
        "method": "POST", "auth": "Bearer", "secret": "RULEBOOK_TODOIST_TOKEN",
        "body": {"project_id": "$destination", "content": "$title", "description": "$text"},
        "receipt": "id"
      }
    }
  }
}
